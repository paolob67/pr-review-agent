<mxfile host="app.diagrams.net">
  <diagram id="arch-overview" name="Architecture overview">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gh" value="GitHub repository" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#57606a;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="280" height="580" as="geometry" />
        </mxCell>
        <mxCell id="event" value="Pull request event&#xa;(opened, updated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="gh">
          <mxGeometry x="30" y="45" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="Team CI&#xa;build, unit tests, required checks&#xa;(runs on pull_request, no secrets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#57606a;" vertex="1" parent="gh">
          <mxGeometry x="30" y="125" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Fork and Dependabot runs&#xa;receive no secrets from GitHub;&#xa;the review workflow runs only&#xa;from the default branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;dashed=1;" vertex="1" parent="gh">
          <mxGeometry x="30" y="225" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="comment" value="Advisory PR comment, marked AI Assisted&#xa;(one, updated in place, with cost footer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="gh">
          <mxGeometry x="30" y="405" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="human" value="Human reviewer&#xa;makes the final evaluation&#xa;(approve or request changes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#57606a;fontStyle=1;" vertex="1" parent="gh">
          <mxGeometry x="30" y="500" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="wf" value="Review workflow (workflow_run, default branch, never checks out PR code)&#xa;three jobs, three fresh GitHub-hosted runners (ubuntu-24.04)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#57606a;fontStyle=1;startSize=40;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="520" height="580" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="Job 1: prepare&#xa;read-only GITHUB_TOKEN, no other secret&#xa;check CI green for this SHA, head unchanged,&#xa;author policy, kill switch, size gates,&#xa;load team rules from the base branch,&#xa;redact secrets, build prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="wf">
          <mxGeometry x="30" y="60" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="review" value="Job 2: review&#xa;BOB_API_KEY only, no SCM token on this machine&#xa;hardened container: scrubbed environment,&#xa;separate Bob UID, read-only rootfs,&#xa;untrusted scratch directory,&#xa;read-only tools, no MCP, timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c5cd8;" vertex="1" parent="wf">
          <mxGeometry x="30" y="205" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="Job 3: publish&#xa;GITHUB_TOKEN with issues: write only, no Bob key&#xa;treat result as untrusted, validate findings,&#xa;sanitise markdown,&#xa;add AI Assisted header, footer and cost record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="wf">
          <mxGeometry x="30" y="378" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="Environment bob-review&#xa;BOB_API_KEY&#xa;default branch only" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fef3c7;strokeColor=#57606a;" vertex="1" parent="wf">
          <mxGeometry x="340" y="60" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="Audit log and cost record&#xa;(job summary and&#xa;audit artifact)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f7f8fa;strokeColor=#57606a;" vertex="1" parent="wf">
          <mxGeometry x="340" y="393" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bob" value="Bob service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c5cd8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="283" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="event" target="ci">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="workflow_run:&#xa;CI conclusion" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ci" target="prepare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="artifact: prompt (data)" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prepare" target="review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="artifact: result (untrusted)" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="review" target="publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="review request" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="review" target="bob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5b" value="secret read by this step only" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.15;" edge="1" parent="1" source="secrets" target="review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="post or update" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="publish" target="comment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6b" value="" style="endArrow=classic;html=1;rounded=0;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="publish" target="logs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="comment" target="human">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
