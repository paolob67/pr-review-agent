<mxfile host="app.diagrams.net">
  <diagram id="arch-overview" name="Architecture overview">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gh" value="GitHub" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#57606a;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="280" height="520" as="geometry" />
        </mxCell>
        <mxCell id="event" value="Pull request event&#xa;(opened, updated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="gh">
          <mxGeometry x="30" y="45" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="Team CI&#xa;build, unit tests, required checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#57606a;" vertex="1" parent="gh">
          <mxGeometry x="30" y="125" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="Review trigger workflow&#xa;starts only if required CI is green&#xa;for this head commit,&#xa;never checks out PR code,&#xa;passes repo, PR number, head SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82d4;" vertex="1" parent="gh">
          <mxGeometry x="30" y="220" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="comment" value="Advisory PR comment, marked AI Assisted&#xa;(one, updated in place, with cost footer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="gh">
          <mxGeometry x="30" y="365" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="human" value="Human reviewer&#xa;makes the final evaluation&#xa;(approve or request changes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#57606a;fontStyle=1;" vertex="1" parent="gh">
          <mxGeometry x="30" y="450" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ce" value="IBM Cloud Code Engine job run (Frankfurt, eu-de)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#57606a;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="520" height="520" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="1. Prepare (wrapper user)&#xa;read-only GitHub token&#xa;fetch diff for head SHA, check head unchanged,&#xa;load team rules from the base branch,&#xa;gate, redact secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="ce">
          <mxGeometry x="30" y="60" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="review" value="2. Review (separate Bob user)&#xa;standards, team rules, security,&#xa;triage, proposed fixes as text&#xa;Bob key only, scrubbed environment,&#xa;untrusted scratch directory,&#xa;read-only, no MCP, timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c5cd8;" vertex="1" parent="ce">
          <mxGeometry x="30" y="205" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="3. Publish (wrapper user)&#xa;comment-only token, no Bob key&#xa;validate findings, sanitise markdown,&#xa;add AI Assisted header, footer and cost record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="ce">
          <mxGeometry x="30" y="370" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="Code Engine secrets&#xa;Bob key, comment token" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fef3c7;strokeColor=#57606a;" vertex="1" parent="ce">
          <mxGeometry x="330" y="370" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="Audit log and cost record&#xa;(IBM Cloud Logs)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f7f8fa;strokeColor=#57606a;" vertex="1" parent="ce">
          <mxGeometry x="330" y="70" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bob" value="Bob service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c5cd8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="240" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="event" target="ci">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="green" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ci" target="trigger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="job run submit:&#xa;repo, PR number, head SHA" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="trigger" target="prepare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="prepare" target="review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="review" target="publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="review request" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="review" target="bob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="post or update" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="publish" target="comment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="comment" target="human">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
