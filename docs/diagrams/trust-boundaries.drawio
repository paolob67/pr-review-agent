<mxfile host="app.diagrams.net">
  <diagram id="trust-boundaries" name="Trust boundaries">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Zone 1: Untrusted PR Zone -->
        <mxCell id="zone_untrusted" value="Untrusted Zone (PR Author / Fork / External Code)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="230" height="700" as="geometry" />
        </mxCell>
        <mxCell id="pr_payload" value="Untrusted PR Input&#xa;&#x2022; Code diff &amp; changed files&#xa;&#x2022; PR title &amp; description&#xa;&#x2022; Branch &amp; author name&#xa;&#x2022; Commit messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e11d48;" vertex="1" parent="zone_untrusted">
          <mxGeometry x="15" y="45" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="threat_vectors" value="Threat Vectors&#xa;&#x2022; Prompt injection (AC-1, AC-2)&#xa;&#x2022; Rule tampering (AC-3)&#xa;&#x2022; Tracking pixels / HTML (AC-7)&#xa;&#x2022; Resource exhaustion (AC-10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e11d48;" vertex="1" parent="zone_untrusted">
          <mxGeometry x="15" y="175" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pr_comments_feed" value="GitHub PR Discussion Feed&#xa;(Advisory Comment Only)&#xa;&#x2022; One comment updated in place&#xa;&#x2022; No approval / No merge block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#57606a;" vertex="1" parent="zone_untrusted">
          <mxGeometry x="15" y="555" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Zone 2: GitHub-hosted runners -->
        <mxCell id="zone_runners" value="GitHub Actions workflow (default branch definition), three jobs on three fresh GitHub-hosted runners" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;fontStyle=1;startSize=40;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="620" height="700" as="geometry" />
        </mxCell>

        <!-- Job 1 -->
        <mxCell id="tb1_box" value="TB-1: Trigger Boundary (validated primitives only: repo, PR#, head_sha)&#xa;workflow_run conclusion, required CI green for this SHA (G12, G31),&#xa;author policy (G7), kill switch (G10)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontStyle=1;align=left;" vertex="1" parent="zone_runners">
          <mxGeometry x="20" y="55" width="580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="stage1" value="Job 1: prepare (read-only GITHUB_TOKEN only; permissions: contents, pull-requests, actions read)&#xa;&#x2022; Verify head SHA unchanged (G32) &#xa;&#x2022; Load base rules via API (G33)&#xa;&#x2022; Size gates (G8) &amp; secret redaction (G15)&#xa;&#x2022; Upload artifact: prompt (data only, short retention G26)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82d4;align=left;" vertex="1" parent="zone_runners">
          <mxGeometry x="20" y="145" width="580" height="95" as="geometry" />
        </mxCell>

        <!-- TB-2 -->
        <mxCell id="tb2_box" value="TB-2: Review Execution Boundary = job boundary&#xa;&#x2022; Fresh VM: no SCM token exists on this machine (G2, G23, G25)&#xa;&#x2022; Container: read-only rootfs, caps dropped, scratch directory, env -i (G3, G28, G29)&#xa;&#x2022; --disable-tool-groups edit,execute --disable-mcp (G4, G30)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;align=left;" vertex="1" parent="zone_runners">
          <mxGeometry x="20" y="265" width="580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stage2" value="Job 2: review (BOB_API_KEY only, environment bob-review, default branch only)&#xa;&#x2022; IBM Bob Shell (v2.0.9, bob run -f json), separate Bob UID&#xa;&#x2022; Process timeout (G13) and job timeout-minutes (G21)&#xa;&#x2022; Upload artifact: result (untrusted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c5cd8;align=left;" vertex="1" parent="zone_runners">
          <mxGeometry x="20" y="375" width="580" height="85" as="geometry" />
        </mxCell>

        <!-- TB-3 -->
        <mxCell id="tb3_box" value="TB-3: Publishing Output Boundary (result artifact is untrusted input)&#xa;&#x2022; Strict JSON schema validation (G16, G36), line in diff and rule ID check (G36)&#xa;&#x2022; Markdown sanitizer (G17), advisory header and footer (G19, G35)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;align=left;" vertex="1" parent="zone_runners">
          <mxGeometry x="20" y="485" width="580" height="75" as="geometry" />
        </mxCell>
        <mxCell id="stage3" value="Job 3: publish (GITHUB_TOKEN with issues: write only; no Bob key)&#xa;&#x2022; Single upsert marker comment (G18, G34) &#xa;&#x2022; Cost record (G37), audit log in job summary and artifact (G20, G27)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;align=left;" vertex="1" parent="zone_runners">
          <mxGeometry x="20" y="575" width="580" height="90" as="geometry" />
        </mxCell>

        <!-- Zone 4: External Bob Service -->
        <mxCell id="zone_bob" value="IBM Bob Service" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="940" y="325" width="210" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bob_backend" value="IBM Bob Inference API&#xa;&#x2022; Model reasoning&#xa;&#x2022; HTTPS from a runner whose location is not selectable (S13)&#xa;&#x2022; Returns single JSON result line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;" vertex="1" parent="zone_bob">
          <mxGeometry x="15" y="45" width="180" height="135" as="geometry" />
        </mxCell>

        <!-- Connecting Arrows -->
        <mxCell id="e1" value="PR event" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pr_payload" target="tb1_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Passes" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="zone_runners" source="tb1_box" target="stage1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="artifact: prompt" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="zone_runners" source="stage1" target="tb2_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Runs Bob read-only" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="zone_runners" source="tb2_box" target="stage2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="HTTPS" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stage2" target="bob_backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="artifact: result" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="zone_runners" source="stage2" target="tb3_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Validated Findings" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="zone_runners" source="tb3_box" target="stage3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="post or update" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="stage3" target="pr_comments_feed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
