@@ -0,0 +1,10 @@
+import { readFile } from 'node:fs/promises';
+import { join } from 'node:path';
+
+const BASE = '/srv/app/uploads';
+
+export async function download(req, res) {
+  const target = join(BASE, req.query.file);
+  const data = await readFile(target);
+  res.end(data);
+}
